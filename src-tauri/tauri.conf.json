{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuckZhihuishuPro",
  "version": "1.0.3",
  "identifier": "com.declanhe.fuckzhihuishupro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FZHS Pro v1.0.3",
        "width": 960,
        "height": 680,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
